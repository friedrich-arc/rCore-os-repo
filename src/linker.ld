/*链接脚本*/
/*决定程序在物理内存中的布局*/

OUTPUT_ARCH(riscv)                 /*设置目标平台为risc-v*/
ENTRY(_start)                      /*设置程序入口为entry里定义的_start*/
BASE_ADDRESS = 0x80200000;         /*定义常量0x80200000，也就是内核的初始化代码被放入的地址，内核的第一条指令要准确的放入0x80200000位置，如果内核没有放在此处，则在qemu启动时，rustsbi固件会跳到一个空地址，直接死机*/

SECTIONS                           /*"."指当前位置*/
{
    . = BASE_ADDRESS;              /*当前位置为0x80200000*/
    skernel = .;                   /*记录当前内核的起始位置*/

    stext = .;                      /*记录代码段起始位置，即可执行指令的起始位置*/
    .text : {
        *(.text.entry)              /*（****）注意：.text.entry在第一个位置！entry.asm被塞入这里，*/
        *(.text .text.*)             /* 强制把汇编启动代码放在最前面,确保_startw位于0x80200000 */
    }                               /*从0x80200000这个位置开始，把所有代码都塞入.text:{}段，*/

    . = ALIGN(4K);                   /*把下一个段的起始地址的定位到4KB边界，强制下一个段的起始地址时4096的整数倍（在risc-V64中默认一页为4KB）*/
    etext = .;                       /*记录代码段结束地址*/
    srodata = .;                     /*记录当前段的起始位置*/
    .rodata : {
        *(.rodata .rodata.*)
        *(.srodata .srodata.*)   
    }                               /*rodata段，存放只读数据，只读权限棉纺织意外修改导致崩溃*/
                
    . = ALIGN(4K);
    erodata = .;                     /*定位当前结束位置*/
    sdata = .;                       /*记录代码段开始地址*/
    .data : {
        *(.data .data.*)
        *(.sdata .sdata.*)
    }                                /*data段，存放已初始化的全局/静态变量，可能被读写修改*/

    . = ALIGN(4K);
    edata = .;                      /*定位当前结束位置*/ 
    .bss : {                        
        *(.bss.stack)
        sbss = .;                    /*“sbss = .”记录当前位置：因为stack为栈空间，如果要清零bss，栈空间不需要清空，*/
        *(.sbss .sbss.*)              /*所以从sbss开始清除，不会改变栈空间，同时将栈空间和全局变量分开，防止栈溢出时踩坏全局变量*/
        *(.bss .bss.*)
    }                                /*bss段：存放未初始化的全局/静态变量*/

    . = ALIGN(4K);
    ebss = .;                         /*定位当前结束位置*/  
    ekernel = .;                      /* *****定位内核链接脚本结束位置*****，内核镜像内容全部结束*/

    /DISCARD/ : {
        *(.eh_frame)
    }                                  /*丢弃无用段：将所有叫.eh_frame的段全部丢弃*/
}